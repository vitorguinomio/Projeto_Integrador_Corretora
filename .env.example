# Variáveis de ambiente da HCR Corretora.
# Copie este arquivo para ".env" (que não vai para o Git) e preencha os valores:
#   cp .env.example .env            (Linux / Git Bash)
#   copy .env.example .env          (Windows)
# O Docker Compose lê o .env automaticamente ao rodar "docker compose up".

# Chave secreta que assina os tokens de login (JWT). Obrigatória em qualquer ambiente real.
# Use pelo menos 32 caracteres aleatórios. Para gerar uma:
#   openssl rand -base64 48
#   powershell -Command "[Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))"
# Se ficar vazia, a API gera uma chave temporária a cada reinício (todos precisam logar de novo).
JWT_SECRET=

# Validade do login, em segundos (86400 = 24 horas).
JWT_EXPIRATION_SECONDS=86400

# Banco de dados (os valores abaixo são os padrões do docker-compose.yml)
POSTGRES_DB=corretora_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
